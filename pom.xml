<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>SQLAnalyzer</groupId>
	<artifactId>SQLAnalyzer</artifactId>
	<version>0.0.1-SNAPSHOT</version>
  
	<repositories>
	    <repository>
	        <id>eclipse-nebula</id>
	        <url>https://download.eclipse.org/nebula/releases/latest</url>
	        <layout>p2</layout>
	        <snapshots>
	        	<enabled>false</enabled>
	        </snapshots>
	    </repository>
	</repositories>
	
	<properties>
			<version.compiler.plugin>3.8.0</version.compiler.plugin>
			<version.dependency.plugin>3.7.1</version.dependency.plugin>
			<version.resources.plugin>3.3.1</version.resources.plugin>
			<version.surefire.plugin>3.3.1</version.surefire.plugin>
			<cubrid.jdbc.version>11.3.2.0053</cubrid.jdbc.version>
			<dist.dir>${project.build.directory}/analyzer</dist.dir>
			<cmt.version>1.0.0-SNAPSHOT</cmt.version>
			<pl.server.jar>${project.basedir}/pl_server/pl_server.jar</pl.server.jar>
	</properties>
	<build>
		<finalName>analyzer</finalName>
		<sourceDirectory>src</sourceDirectory>
			<resources>
				<resource>
					<directory>src</directory>
					<excludes>
						<exclude>**/*.java</exclude>
						<exclude>dist/**</exclude>
					</excludes>
				</resource>
				<resource>
					<directory>.</directory>
					<includes>
						<include>logback.xml</include>
					</includes>
				</resource>
			</resources>
		
		<testSourceDirectory>test</testSourceDirectory>
			<testResources>
				<testResource>
					<directory>test</directory>
					<excludes>
						<exclude>**/*.java</exclude>
					</excludes>
				</testResource>
			</testResources>
		
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-jar-plugin</artifactId>
				<version>3.4.2</version>
				<configuration>
					<outputDirectory>${dist.dir}</outputDirectory>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-dependency-plugin</artifactId>
				<version>3.7.1</version>
				<executions>
					<execution>
						<id>copy-runtime-dependencies</id>
						<phase>package</phase>
						<goals>
							<goal>copy-dependencies</goal>
						</goals>
							<configuration>
								<includeScope>runtime</includeScope>
								<excludeArtifactIds>cubrid-jdbc</excludeArtifactIds>
								<outputDirectory>${dist.dir}/lib</outputDirectory>
							</configuration>
						</execution>
						<execution>
							<id>copy-cubrid-jdbc-driver</id>
							<phase>package</phase>
							<goals>
								<goal>copy</goal>
							</goals>
							<configuration>
								<artifactItems>
									<artifactItem>
										<groupId>org.cubrid</groupId>
										<artifactId>cubrid-jdbc</artifactId>
										<version>${cubrid.jdbc.version}</version>
										<type>jar</type>
										<outputDirectory>${dist.dir}/jdbc</outputDirectory>
									</artifactItem>
								</artifactItems>
							</configuration>
						</execution>
				</executions>
			</plugin>
					<plugin>
						<artifactId>maven-compiler-plugin</artifactId>
						<version>3.13.0</version>
						<configuration>
							<release>21</release>
						</configuration>
					</plugin>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-antrun-plugin</artifactId>
						<version>3.1.0</version>
						<executions>
							<execution>
								<id>build-linux-jni</id>
								<phase>generate-resources</phase>
								<goals>
									<goal>run</goal>
								</goals>
								<configuration>
									<target>
										<exec executable="make" dir="${project.basedir}/jni" failonerror="true">
											<arg value="all"/>
										</exec>
									</target>
								</configuration>
							</execution>
							<execution>
								<id>prepare-dist</id>
								<phase>prepare-package</phase>
							<goals>
								<goal>run</goal>
							</goals>
							<configuration>
								<target>
									<delete dir="${dist.dir}"/>
									<mkdir dir="${dist.dir}/jni"/>
									<mkdir dir="${dist.dir}/lib"/>
									<mkdir dir="${dist.dir}/settings"/>
									<copy file="${project.basedir}/jni/libsqlvalidator.so"
										todir="${dist.dir}/jni"/>
									<copy file="${project.basedir}/src/dist/analyzer.sh"
										todir="${dist.dir}"/>
									<copy file="${project.basedir}/src/dist/settings/setting.conf"
										todir="${dist.dir}/settings"/>
									<copy file="${project.basedir}/src/dist/settings/cost.json"
										todir="${dist.dir}/settings"/>
									<copy file="${project.basedir}/src/dist/settings/logback.xml"
										todir="${dist.dir}/settings"/>
									<available file="${pl.server.jar}" property="pl.server.jar.exists"/>
									<fail unless="pl.server.jar.exists"
										message="pl_server jar is missing: ${pl.server.jar}"/>
									<copy file="${pl.server.jar}"
										tofile="${dist.dir}/lib/pl_server.jar"/>
									<chmod file="${dist.dir}/analyzer.sh" perm="755"/>
									<chmod file="${dist.dir}/jni/libsqlvalidator.so" perm="755"/>
								</target>
							</configuration>
						</execution>
						<execution>
							<id>package-linux-distribution</id>
							<phase>package</phase>
							<goals>
								<goal>run</goal>
							</goals>
							<configuration>
								<target>
									<tar destfile="${project.build.directory}/sql-analyzer-${project.version}-linux-x86_64.tar.gz"
										compression="gzip"
										longfile="gnu">
										<tarfileset dir="${dist.dir}"
											prefix="sql-analyzer-${project.version}"
											filemode="0644"
											dirmode="0755">
											<exclude name="analyzer.sh"/>
											<exclude name="jni/libsqlvalidator.so"/>
										</tarfileset>
										<tarfileset dir="${dist.dir}"
											prefix="sql-analyzer-${project.version}"
											filemode="0755"
											dirmode="0755">
											<include name="analyzer.sh"/>
											<include name="jni/libsqlvalidator.so"/>
										</tarfileset>
									</tar>
								</target>
							</configuration>
						</execution>
					</executions>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-surefire-plugin</artifactId>
					<version>${version.surefire.plugin}</version>
					<configuration>
						<useModulePath>false</useModulePath>
					</configuration>
				</plugin>
		</plugins>
	</build>
	<profiles>
		<profile>
			<id>dev-prebuilt-artifacts</id>
			<repositories>
				<repository>
					<id>sqlanalyzer-local-artifacts</id>
					<url>file://${project.basedir}/lib/m2repo</url>
				</repository>
			</repositories>
		</profile>
	</profiles>
	<dependencies>
	    <dependency>
	        <groupId>com.cubrid.cubridmigration</groupId>
	        <artifactId>com.cubrid.cubridmigration.core</artifactId>
	        <version>${cmt.version}</version>
	    </dependency>
	    
	    <dependency>
	        <groupId>com.cubrid.cubridmigration</groupId>
	        <artifactId>com.cubrid.common.configuration</artifactId>
	        <version>${cmt.version}</version>
	    </dependency>

	    <dependency>
	        <groupId>com.beust</groupId>
	        <artifactId>jcommander</artifactId>
	        <version>1.82</version>
	    </dependency>

		<dependency>
		    <groupId>org.mybatis</groupId>
		    <artifactId>mybatis</artifactId>
		    <version>3.5.19</version>
		    <scope>compile</scope>
		</dependency>
		
			<dependency>
				<groupId>org.cubrid</groupId>
				<artifactId>cubrid-jdbc</artifactId>
				<version>${cubrid.jdbc.version}</version>
			</dependency>
		
		<dependency>
			<groupId>org.slf4j</groupId>
			<artifactId>slf4j-api</artifactId>
			<version>2.0.17</version>
		</dependency>
		<dependency>
			<groupId>ch.qos.logback</groupId>
			<artifactId>logback-classic</artifactId>
			<version>1.5.18</version>
		</dependency>
		<dependency>
			<groupId>ch.qos.logback</groupId>
			<artifactId>logback-core</artifactId>
			<version>1.5.18</version>
		</dependency>
		<dependency>
			<groupId>org.mongodb</groupId>
			<artifactId>bson</artifactId>
			<version>5.6.0</version>
		</dependency>
		<dependency>
			<groupId>com.googlecode.lanterna</groupId>
			<artifactId>lanterna</artifactId>
			<version>3.1.2</version>
		</dependency>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter-api</artifactId>
			<version>5.11.4</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter-engine</artifactId>
			<version>5.11.4</version>
			<scope>test</scope>
		</dependency>
	</dependencies>
</project>
